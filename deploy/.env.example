# ============================================================
# FCA 部署环境变量示例。复制为 deploy/.env 后填写。
# ============================================================

# 会话密钥（必填）：改成随机长字符串，生成命令：openssl rand -hex 32
OJ_SECRET=change-me-to-a-long-random-string

# ---------- 路线 A：复用 Supabase（填这个，路线 B 不用管）----------
# 从 Supabase 控制台 Connect → Direct → Transaction pooler 复制，
# 末尾加 ?sslmode=require
# 例：postgresql://postgres.xxxx:密码@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# ---------- 路线 B：自托管 Postgres（填这个，路线 A 不用管）----------
# 强密码即可，生成命令：openssl rand -hex 16
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
